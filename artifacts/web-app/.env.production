# Production build configuration for the web app.
#
# Vite loads env files in this order, with later files overriding earlier ones:
#   .env  ->  .env.local  ->  .env.production  ->  .env.production.local
#
# So this file overrides the localhost value in .env.local whenever the build
# runs in production mode, while leaving local `pnpm dev` untouched (dev uses
# development mode and keeps reading .env.local).
#
# This value is a public URL, not a secret, so it is committed deliberately.
VITE_API_SERVER_URL=https://edu-api-jwon.onrender.com
