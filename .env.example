# Server-only AI credentials. Never prefix secrets with VITE_.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Tutor model routing. These defaults balance answer quality and quota use.
AI_TUTOR_MODEL=llama-3.3-70b-versatile
AI_TUTOR_ANSWER_FALLBACK_MODEL=openai/gpt-oss-120b
AI_TUTOR_HELP_MODEL=openai/gpt-oss-120b
AI_TUTOR_EVALUATION_MODEL=openai/gpt-oss-120b
AI_TUTOR_GRADING_MODEL=openai/gpt-oss-120b
AI_TUTOR_CHAT_MODEL=llama-3.1-8b-instant

# Program ingestion routing.
PROGRAM_INGESTION_GEMINI_MODEL=gemini-2.5-flash
PROGRAM_INGESTION_NORMALIZATION_PROVIDER=gemini
PROGRAM_INGESTION_STRUCTURING_PROVIDER=fallback
PROGRAM_INGESTION_OCR_PROVIDER=tesseract
PROGRAM_INGESTION_MISTRAL_OCR_MODEL=mistral-ocr-latest

# Optional local OCR overrides.
TESSERACT_BIN=
PROGRAM_INGESTION_TESSERACT_LANGUAGE=eng
